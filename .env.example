# Supabase (required for auth and protected shell in development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. When set, todo assignees load from all Auth users (admin API).
# Keep secret — never NEXT_PUBLIC_. Dashboard → Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=

# Without service role: use Table Editor → household_members instead.

# PIN sign-in (server-only). Required for /api/auth/pin and the PIN settings.
# Generate with: openssl rand -hex 32
# Treat as a secret — never NEXT_PUBLIC_. Rotating it invalidates all existing PINs.
# AUTH_PIN_PEPPER=

# Optional later: other server-only secrets must NOT use NEXT_PUBLIC_

# Hermes → Karriqi operator ingest (`POST /api/operator/entries`; Bearer OPERATOR_INGEST_TOKEN).
# Keep secret — never NEXT_PUBLIC_.
# OPERATOR_INGEST_TOKEN=

# Third-party ingest API (`POST /api/ingest/*`; contract at GET /openapi.json).
# Hermes env: KARRIQI_URL, INGEST_TOKEN (Bearer), USER_ID (JSON body userId).
# INGEST_TOKEN=

# Web Push (generate with: pnpm exec web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Register the PWA service worker during `next dev` (needed for Web Push testing).
# Restart `pnpm dev` after changing. Omit for faster dev without a worker.
# ENABLE_PWA_IN_DEV=true

# Secured cron (Authorization: Bearer $CRON_SECRET). Used by:
#   GET|POST /api/cron/stale-tasks      — assigned-task inactivity reminders
#   GET|POST /api/cron/rehab-reminders  — push 5 min before each timed rehab event
# /api/cron/rehab-reminders is polled every minute by Supabase pg_cron (see
# supabase/migrations/20260601220000_rehab_reminders_pg_cron.sql). For that to
# fire, set the SAME value here/in Cloudflare AND in Supabase Vault as a secret
# named `cron_secret` (lib/push/README.md has the SQL). No external cron needed.
# CRON_SECRET=

# Google Calendar two-way sync (server-only). Create OAuth credentials in Google Cloud Console
# with Calendar API enabled. Authorized redirect URI must include:
#   https://your-domain/api/integrations/google/calendar/callback
#   http://localhost:3010/api/integrations/google/calendar/callback  (and other worktree ports)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: separate HMAC secret for OAuth state if AUTH_PIN_PEPPER is unset
# GOOGLE_OAUTH_STATE_SECRET=
#
# Calendar is view-only by default when Google is connected (edit in Google, then Sync).
# Set CALENDAR_READONLY=0 to allow create/edit/delete inside Karriqi again.
# CALENDAR_READONLY=1
