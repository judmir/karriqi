# Supply-chain hardening for pnpm.
# Keep settings in sync with package.json#packageManager.

# Only resolve from the official npm registry. Blocks compromised mirrors and
# any malicious .npmrc smuggled into a tarball from redirecting installs.
registry=https://registry.npmjs.org/

# Prefer the committed lockfile; pnpm auto-flips to fully frozen on CI
# (CI=true). Together with the lockfile this gives us reproducible installs
# and stops silent transitive dependency injection.
prefer-frozen-lockfile=true

# When adding a dep with `pnpm add`, save an exact version (no `^`). Combined
# with overrides + lockfile, this makes our dependency surface auditable and
# blocks silent floats into compromised patch versions (Shai-Hulud /
# @tanstack/* style supply-chain attacks).
save-exact=true

# pnpm 10 already requires explicit approval for dep install scripts via
# `pnpm.onlyBuiltDependencies` / `ignoredBuiltDependencies` in package.json.
# We additionally turn off pre/post scripts for the workspace itself so a
# malicious `prepare` smuggled into a tarball can't piggyback on our hooks.
enable-pre-post-scripts=false
